              "raw": "{\n  \"currentPassword\": \"Password123!\",\n  \"newPassword\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/password",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "password"]
            }
          }
        },
        {
          "name": "5.4 Sincronizar Token FCM del Dispositivo",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-client-type", "value": "mobile" },
              { "key": "x-token", "value": "{{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"emulator-5554\",\n  \"fcmToken\": \"nuevo-fcm-token-98765\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/fcm-token",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "fcm-token"]
            }
          }
        },
        {
          "name": "5.5 Crear Respaldo Cifrado AES-256 (.v2.ylk)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-client-type", "value": "mobile" },
              { "key": "x-token", "value": "{{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/backups?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["backups"],
              "query": [
                { "key": "userId", "value": "{{userId}}" }
              ]
            }
          }
        },
        {
          "name": "5.6 Restaurar Respaldo desde la Nube",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-client-type", "value": "mobile" },
              { "key": "x-token", "value": "{{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/backups/restore?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["backups", "restore"],
              "query": [
                { "key": "userId", "value": "{{userId}}" }
              ]
            }
          }
        },
        {
          "name": "5.7 Eliminar Cuenta de Usuario (Soft Delete en Cascada)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "x-client-type", "value": "mobile" },
