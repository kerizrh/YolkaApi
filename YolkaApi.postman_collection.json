  "item": [
    {
      "name": "1. Autenticación y Sesiones (Módulo 1)",
      "item": [
        {
          "name": "1.1 Registro de Usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) pm.collectionVariables.set('token', res.token);",
                  "if (res.refreshToken) pm.collectionVariables.set('refreshToken', res.refreshToken);",
                  "if (res.user && res.user.id) pm.collectionVariables.set('userId', res.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-client-type", "value": "mobile" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Carlos Mendoza\",\n  \"email\": \"carlos@yolka.app\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\",\n  \"phone\": \"+52 55 1234 5678\",\n  \"deviceId\": \"emulator-5554\",\n  \"deviceToken\": \"fcm-demo-token-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "1.2 Confirmar Cuenta por Código (JSON)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/confirm-account",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "confirm-account"]
            }
          }
        },
        {
          "name": "1.3 Confirmar Cuenta por Enlace (GET HTML)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/confirm-account?token=123456",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "confirm-account"],
              "query": [
                { "key": "token", "value": "123456" }
              ]
            }
          }
        },
        {
          "name": "1.4 Reenviar Enlace/Código de Confirmación",
          "request": {
