              "raw": "{\n  \"category\": \"FEEDING\",\n  \"title\": \"Desayuno (200g croquetas)\",\n  \"time\": \"08:00\",\n  \"daysOfWeek\": [\"MON\", \"TUE\", \"WED\", \"THU\", \"FRI\", \"SAT\", \"SUN\"],\n  \"enabled\": true,\n  \"notes\": \"Servir con agua fresca\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pets/{{petId}}/routines",
              "host": ["{{baseUrl}}"],
              "path": ["pets", "{{petId}}", "routines"]
            }
          }
        },
        {
          "name": "3.5 Agregar Recordatorio a Mascota",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.pet && res.pet.reminders && res.pet.reminders.length > 0) {",
                  "  pm.collectionVariables.set('reminderId', res.pet.reminders[res.pet.reminders.length - 1].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-client-type", "value": "mobile" },
              { "key": "x-token", "value": "{{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"GROOMING\",\n  \"title\": \"Baño y corte de uñas\",\n  \"dateTime\": \"2026-10-28T11:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pets/{{petId}}/reminders",
              "host": ["{{baseUrl}}"],
              "path": ["pets", "{{petId}}", "reminders"]
            }
          }
        },
        {
          "name": "3.6 Marcar Recordatorio como Completado",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "x-client-type", "value": "mobile" },
              { "key": "x-token", "value": "{{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/pets/{{petId}}/reminders/{{reminderId}}?completed=true",
              "host": ["{{baseUrl}}"],
              "path": ["pets", "{{petId}}", "reminders", "{{reminderId}}"],
              "query": [
                { "key": "completed", "value": "true" }
              ]
            }
          }
        }
      ]
    },
