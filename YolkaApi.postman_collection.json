{
  "info": {
    "_postman_id": "d8b47d10-91a3-4b5a-8e77-019283746501",
    "name": "Yolka API — Colección Completa",
    "description": "Colección de pruebas para los 10 módulos de YolkaApi (Spring Boot + MongoDB Atlas). Incluye scripts automáticos que guardan el token (x-token), userId y petId al ejecutar Login/Registro y Crear Mascota.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "petId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación (Módulo 1)",
      "item": [
        {
          "name": "1.1 Registro de Usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) pm.collectionVariables.set('token', res.token);",
                  "if (res.user && res.user.id) pm.collectionVariables.set('userId', res.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-client-type", "value": "mobile" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Carlos Mendoza\",\n  \"email\": \"carlos@yolka.app\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\",\n  \"phone\": \"+52 55 1234 5678\",\n  \"deviceId\": \"emulator-5554\",\n  \"deviceToken\": \"fcm-demo-token-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "1.2 Login por Correo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) pm.collectionVariables.set('token', res.token);",
                  "if (res.user && res.user.id) pm.collectionVariables.set('userId', res.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-client-type", "value": "mobile" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carlos@yolka.app\",\n  \"password\": \"Password123!\",\n  \"deviceId\": \"emulator-5554\",\n  \"deviceToken\": \"fcm-demo-token-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.3 Login / Registro con Google",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) pm.collectionVariables.set('token', res.token);",
                  "if (res.user && res.user.id) pm.collectionVariables.set('userId', res.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-client-type", "value": "mobile" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"PEGA_AQUI_EL_ID_TOKEN_DE_GOOGLE\",\n  \"deviceId\": \"emulator-5554\",\n  \"deviceToken\": \"fcm-demo-token-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google"]
            }
          }
        },
        {
          "name": "1.4 Solicitar Recuperación de Contraseña",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carlos@yolka.app\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/recover-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "recover-password"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Mascotas (Módulo 2)",
      "item": [
        {
          "name": "2.1 Crear Mascota (Perro)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.pet && res.pet.id) pm.collectionVariables.set('petId', res.pet.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-client-type", "value": "mobile" },
              { "key": "x-token", "value": "{{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"name\": \"Max\",\n  \"species\": \"DOG\",\n  \"breed\": \"Golden Retriever\",\n  \"color\": \"Dorado\",\n  \"gender\": \"MALE\",\n  \"birthDate\": \"2023-05-14\",\n  \"ageYears\": 3,\n  \"weight\": 28.5,\n  \"size\": \"LARGE\",\n  \"photoUrl\": \"https://images.unsplash.com/photo-1552053831-71594a27632d\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pets",
              "host": ["{{baseUrl}}"],
              "path": ["pets"]
            }
          }
        },
        {
          "name": "2.2 Listar Mascotas del Usuario",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-client-type", "value": "mobile" },
              { "key": "x-token", "value": "{{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/pets?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["pets"],
              "query": [
                { "key": "userId", "value": "{{userId}}" }
              ]
            }
          }
        },
        {
          "name": "2.3 Consultar Perfil y Expediente de Mascota",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-client-type", "value": "mobile" },
              { "key": "x-token", "value": "{{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/pets/{{petId}}",
              "host": ["{{baseUrl}}"],
              "path": ["pets", "{{petId}}"]
            }
          }
        },
        {
          "name": "2.4 Editar Mascota",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-client-type", "value": "mobile" },
              { "key": "x-token", "value": "{{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Max\",\n  \"species\": \"DOG\",\n  \"breed\": \"Golden Retriever\",\n  \"color\": \"Miel\",\n  \"gender\": \"MALE\",\n  \"birthDate\": \"2023-05-14\",\n  \"ageYears\": 3,\n  \"weight\": 29.2,\n  \"size\": \"LARGE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pets/{{petId}}",
              "host": ["{{baseUrl}}"],
              "path": ["pets", "{{petId}}"]
            }
          }
        }
      ]
    },
    {
